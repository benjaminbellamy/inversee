#: data/fr.benjaminbellamy.Inversee.desktop.in:2
#: data/fr.benjaminbellamy.Inversee.metainfo.xml.in:11 src/ui/window.vala:35
msgid "Inversée"
msgstr ""

#: data/fr.benjaminbellamy.Inversee.desktop.in:3
#: data/fr.benjaminbellamy.Inversee.metainfo.xml.in:12
msgid "Reverse Polish Notation calculator"
msgstr "Taschenrechner mit umgekehrter polnischer Notation"

#: data/fr.benjaminbellamy.Inversee.desktop.in:4
msgid "RPN;calculator;reverse;polish;notation;HP;maths;"
msgstr "RPN;UPN;Rechner;Taschenrechner;HP;Mathematik;"

#: data/fr.benjaminbellamy.Inversee.metainfo.xml.in:15
msgid ""
"Inversée is a Reverse Polish Notation (RPN) calculator with an unbounded "
"stack, designed to look and behave like a native GNOME application."
msgstr ""
"Inversée ist ein Taschenrechner mit umgekehrter polnischer Notation (UPN) "
"und unbegrenztem Stapel, der wie eine native GNOME-Anwendung aussehen und "
"sich verhalten soll."

#: data/fr.benjaminbellamy.Inversee.metainfo.xml.in:19
msgid ""
"The full stack is visible at all times, values are stored as arbitrary "
"precision MPFR floats, and the locale-aware display follows your system "
"settings."
msgstr ""
"Der gesamte Stapel ist jederzeit sichtbar, Werte werden als MPFR-"
"Gleitkommazahlen mit beliebiger Genauigkeit gespeichert, und die "
"gebietsschemabewusste Anzeige folgt den Systemeinstellungen."

