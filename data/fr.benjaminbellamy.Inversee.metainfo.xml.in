<component type="desktop-application">
  <id>fr.benjaminbellamy.Inversee</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Inversée</name>
  <summary>Reverse Polish Notation calculator</summary>

  <description>
    <p>
      Inversée is a Reverse Polish Notation (RPN) calculator with an unbounded
      stack, designed to look and behave like a native GNOME application.
    </p>
    <p>
      The full stack is visible at all times, values are stored as arbitrary
      precision MPFR floats, and the locale-aware display follows your
      system settings.
    </p>
  </description>

  <categories>
    <category>Utility</category>
    <category>Calculator</category>
  </categories>

  <keywords>
    <keyword>RPN</keyword>
    <keyword>calculator</keyword>
    <keyword>reverse</keyword>
    <keyword>polish</keyword>
    <keyword>notation</keyword>
    <keyword>HP</keyword>
    <keyword>maths</keyword>
  </keywords>

  <launchable type="desktop-id">fr.benjaminbellamy.Inversee.desktop</launchable>

  <provides>
    <binary>inversee</binary>
  </provides>

  <url type="homepage">https://github.com/benjaminbellamy/inversee</url>
  <url type="bugtracker">https://github.com/benjaminbellamy/inversee/issues</url>
  <url type="vcs-browser">https://github.com/benjaminbellamy/inversee</url>

  <developer id="fr.benjaminbellamy">
    <name>Benjamin Bellamy</name>
  </developer>

  <update_contact>benjamin_AT_castopod.org</update_contact>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <branding>
    <color type="primary" scheme_preference="light">#cf354f</color>
    <color type="primary" scheme_preference="dark">#5e5e5e</color>
  </branding>

  <screenshots>
    <screenshot type="default" environment="gnome">
      <image>https://raw.githubusercontent.com/benjaminbellamy/inversee/main/data/screenshots/screenshot-red-light.png</image>
      <caption>Light mode with the red accent.</caption>
    </screenshot>
    <screenshot environment="gnome:dark">
      <image>https://raw.githubusercontent.com/benjaminbellamy/inversee/main/data/screenshots/screenshot-red-dark.png</image>
      <caption>Dark mode with the red accent.</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/benjaminbellamy/inversee/main/data/screenshots/screenshot-blue-light.png</image>
      <caption>Light mode with the blue accent.</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/benjaminbellamy/inversee/main/data/screenshots/screenshot-blue-dark.png</image>
      <caption>Dark mode with the blue accent.</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/benjaminbellamy/inversee/main/data/screenshots/screenshot-teal-light.png</image>
      <caption>Light mode with the teal accent.</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/benjaminbellamy/inversee/main/data/screenshots/screenshot-teal-dark.png</image>
      <caption>Dark mode with the teal accent.</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.3.2" date="2026-08-27">
      <description>
        <p>A refreshed Clear key icon.</p>
        <ul>
          <li>The Clear key icon has been redrawn: the circle now encloses two stacked crosses instead of a single centred one.</li>
        </ul>
      </description>
    </release>
    <release version="1.3.1" date="2026-05-28">
      <description>
        <p>Fix the missing keypad icons in the Flatpak build.</p>
        <ul>
          <li>The Enter, Clear, and Backspace key icons now load straight from the embedded GResource, so they render correctly under the GNOME 49 runtime where the icon-theme resource path silently dropped them.</li>
          <li>About dialog and README rewritten with a short introduction to Reverse Polish Notation and to the Automatic number format.</li>
        </ul>
      </description>
    </release>
    <release version="1.3.0" date="2026-05-27">
      <description>
        <p>A configurable number format and refreshed keypad keys.</p>
        <ul>
          <li>New “Number format” menu sets the decimal separator, the thousands separator, and the clipboard behaviour together — Automatic (the default), System, or a fixed convention (1,234.56, 1 234,56, 1.234,56) — applied live with no restart.</li>
          <li>Clipboard paste is more forgiving: it ignores currency symbols, units, and labels around a number, handles smart digit grouping, and reads both decimal conventions; values can be separated by “;”, newlines, or tabs.</li>
          <li>The Enter, Clear, and Backspace keys now use custom icons that follow the accent colour and the light/dark theme.</li>
          <li>The About dialog shows a short Reverse Polish Notation quick-start.</li>
          <li>Translations updated across all eight locales.</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-05-23">
      <description>
        <p>Help rebinding the keyboard's Calculator key, plus screenshot polish.</p>
        <ul>
          <li>New hamburger-menu entry “Reassign calculator key…” walks the user through GNOME Settings → Keyboard so they can replace the default Launch Calculator shortcut with one that runs Inversée. Includes a one-click copy of the launch command and an Open Settings shortcut.</li>
          <li>The AppStream screenshot carousel now showcases all three accent variants (red, blue, teal) in both light and dark mode, instead of only the red pair.</li>
          <li>Translations updated across all eight locales.</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-05-23">
      <description>
        <p>Visual polish and a deeper accessibility pass.</p>
        <ul>
          <li>Custom keypad styling: digit keys sit one shade darker than the window background, Clear uses a lightened wash of the accent, and every keypad button picks up a slightly rounder corner (Enter and Clear rounder still). All colours track the user's accent and the light/dark theme.</li>
          <li>Stack rows are announced by register name to screen readers: "X register, …", "Y register, …", "Z register, …", then "Stack level N, …" beyond.</li>
          <li>The entry/error area, the empty-stack placeholder transition, and the clipboard toasts all surface via AT-SPI announcements.</li>
          <li><code>F10</code> opens the main menu from anywhere in the window.</li>
          <li><code>Ctrl+Shift+C</code> copies the entire stack to the clipboard.</li>
          <li>Build floor raised to GTK 4.14 for <code>gtk_accessible_announce()</code>.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.2" date="2026-05-13">
      <description>
        <p>Pre-Flathub polish round.</p>
        <ul>
          <li>Accessibility: glyph-only keypad and header-bar buttons now expose AT-SPI accessible names for screen readers.</li>
          <li>The keyboard-shortcuts dialog is now a native <code>GtkShortcutsWindow</code> with grouped, searchable entries.</li>
          <li>AppStream metainfo declares minimum display length and recommended input controls (keyboard, pointing, touch).</li>
          <li>Translation catalogues filled in for all eight locales.</li>
          <li>The LICENSE file is installed inside the Flatpak at <code>/app/share/licenses/</code> as Flathub requires.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.1" date="2026-05-13">
      <description>
        <p>Maintenance release. Build-pipeline updates only — no user-facing changes.</p>
        <ul>
          <li>GMP and MPFR build with <code>-std=gnu17</code> so they configure cleanly under freedesktop SDK 25.08 (GCC 15).</li>
          <li>Runtime moved from end-of-life GNOME 48 to supported GNOME 49.</li>
          <li>AppStream metainfo: categories, keywords, update contact, and a second screenshot for dark mode.</li>
          <li>CI: tagged pushes now auto-upload the Flatpak bundle to the matching GitHub Release.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-05-13">
      <description>
        <p>First public release.</p>
        <ul>
          <li>Unbounded RPN stack with swap, drop, rot, dup, dup2 and clear.</li>
          <li>Arbitrary-precision arithmetic via MPFR (128-bit internal).</li>
          <li>Full operation set: + − × ÷ mod %, x^y, √, 1/x, +/−.</li>
          <li>Unbounded undo, capped at 1000 entries per session.</li>
          <li>Locale-aware display, locale-tolerant clipboard paste.</li>
          <li>Clipboard menu: paste, copy X, copy whole stack.</li>
          <li>Session persistence to $XDG_DATA_HOME/inversee/state.json.</li>
          <li>Window geometry and chosen UI language persisted via GSettings.</li>
          <li>Translations: English, French, German, Italian, Spanish, Dutch, Polish, Portuguese.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-05-12">
      <description>
        <p>Initial scaffold.</p>
      </description>
    </release>
  </releases>
</component>
